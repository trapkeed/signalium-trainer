[Unit]
Description=Signalium Trainer API (PM2)
Documentation=https://github.com/trapkeed/signalium-trainer
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=signalium
Group=signalium
WorkingDirectory=/opt/signalium-trainer

# Let PM2 manage the Node process; --no-daemon keeps PM2 in the foreground
# so systemd can track and restart it.
ExecStart=/usr/bin/env pm2 start deploy/pm2/ecosystem.config.cjs --no-daemon --env production

ExecStop=/usr/bin/env pm2 stop signalium-trainer-api
ExecReload=/usr/bin/env pm2 reload signalium-trainer-api

# Environment
Environment=NODE_ENV=production
EnvironmentFile=-/opt/signalium-trainer/.env

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=3

# Logging — journald captures stdout/stderr
StandardOutput=journal
StandardError=journal
SyslogIdentifier=signalium-api

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

# Auto-create runtime dirs owned by the service user
LogsDirectory=signalium-trainer
StateDirectory=signalium-trainer
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
