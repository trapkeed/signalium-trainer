modules = ["python-3.12", "nodejs-20", "bash", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["abseil-cpp", "antlr", "arrow-cpp", "cargo", "glibcLocales", "gtest", "jre", "libiconv", "libxcrypt", "libyaml", "oneDNN", "openssl", "pkg-config", "re2", "rustc"]
