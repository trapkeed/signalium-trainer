# =============================================================================
# Signalium Trainer — environment variables
# Copy this file to .env and fill in your values.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Trainer API listens on. nginx proxies /api/* to this port.
PORT=3000

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_generate_a_random_32_byte_hex_string

# Admin token for the Research Lab API (/api/admin/research/*).
# Any strong random string works. Keep this secret.
RESEARCH_LAB_ADMIN_TOKEN=change_me_strong_random_token

# ── Platform integration ───────────────────────────────────────────────────────
# API key for outbound calls to the Signalium platform.
# Leave blank to disable push (the API will start but outbound calls are skipped).
SIGNALIUM_PLATFORM_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file.
# Defaults to <repo-root>/data/research_lab.db if not set.
# RESEARCH_LAB_DB_PATH=/opt/signalium-trainer/data/research_lab.db

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info
