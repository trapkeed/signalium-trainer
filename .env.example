# =============================================================================
# Signalium Trainer — environment variables
# =============================================================================
# Copy this file to .env and fill in every REQUIRED value before starting.
# Lines marked REQUIRED must be set; lines marked OPTIONAL have safe defaults.
#
#   cp .env.example .env
#   # edit .env
#   docker compose up --build -d
# =============================================================================


# =============================================================================
# TRAINER API (Node.js)
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
# [REQUIRED] Port the Trainer API listens on.
PORT=3000

# [OPTIONAL] Host port exposed on the Docker host (docker-compose.yml).
# Defaults to the same value as PORT.
# TRAINER_API_PORT=3000

# ── Inbound auth — platform → trainer ────────────────────────────────────────
# [REQUIRED] JWKS endpoint published by the Signalium platform.
# The trainer uses this to verify the ES256 JWTs on all platform routes.
# No API key or shared secret is needed — the platform signs its own tokens.
SIGNALIUM_JWKS_URL=https://signaliumai.com/sso/jwks

# ── Internal shared secret — Node API ↔ Python Research Lab ──────────────────
# [REQUIRED] Static bearer token that the Node Trainer API sends on every
# request to the Python Research Lab service, and that the Python service
# validates.  Set the SAME value in both containers.
#
# Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   python3 -c "import secrets; print(secrets.token_hex(32))"
RESEARCH_LAB_ADMIN_TOKEN=change_me_strong_random_token

# ── Internal service URLs ─────────────────────────────────────────────────────
# [REQUIRED in docker-compose] Use Docker service names, not localhost.
# docker-compose.yml already sets these correctly; only override for custom
# network layouts.
#
# RESEARCH_LAB_API_URL=http://research-lab:8002
# QDE_API_URL=http://qde:8001

# ── Session ───────────────────────────────────────────────────────────────────
# [REQUIRED] Secret used to sign HTTP sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_strong_random_secret

# ── Outbound auth — trainer → Signalium platform ──────────────────────────────
# [REQUIRED for telemetry push] API key for outbound calls to the platform
# (telemetry, ticks, heartbeat, execution quality, symbol discovery).
# Leave blank to disable outbound push — the trainer starts normally but any
# route that calls the platform will throw PlatformClientError.
# Obtain from: Admin → API Keys on the Signalium platform.
# SIGNALIUM_PLATFORM_API_KEY=

# [OPTIONAL] Base URL override for staging/testing.
# SIGNALIUM_PLATFORM_BASE_URL=https://staging.signaliumai.com/api

# ── Database ──────────────────────────────────────────────────────────────────
# [OPTIONAL] PostgreSQL connection string (if the API uses a relational DB).
# DATABASE_URL=postgresql://user:password@localhost:5432/signalium_trainer

# ── CORS ──────────────────────────────────────────────────────────────────────
# [OPTIONAL] Comma-separated trusted CORS origins.
# Defaults to signaliumai.com + localhost.
# PLATFORM_ALLOWED_ORIGINS=https://yourdomain.com

# ── Logging ───────────────────────────────────────────────────────────────────
# [OPTIONAL] trace | debug | info | warn | error | fatal  (default: info)
# LOG_LEVEL=info


# =============================================================================
# RESEARCH LAB SERVICE (Python / FastAPI)
# =============================================================================

# ── Storage ───────────────────────────────────────────────────────────────────
# [OPTIONAL] Path inside the container to the SQLite database file.
# The docker-compose.yml mounts a named volume at /app/data by default.
# RESEARCH_LAB_DB_PATH=/app/data/research_lab.db

# ── Signalium SSO — audit-trail enrichment ────────────────────────────────────
# [OPTIONAL but recommended] Signing key used by the Python server to validate
# X-Signalium-Token JWTs forwarded from the Node proxy.  When set, each audit
# log entry records the verified admin identity rather than a synthesised one.
# Without these, the server still accepts requests (using the bearer token
# alone) but audit records show "trainer-api" as the originating identity.
#
# HS256 (default algorithm):
# SIGNALIUM_JWT_SECRET=change_me_strong_jwt_secret
#
# RS256 (alternative — also set SIGNALIUM_JWT_ALGORITHM=RS256):
# SIGNALIUM_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# SIGNALIUM_JWT_ALGORITHM=RS256

# ── Scheduler ─────────────────────────────────────────────────────────────────
# [OPTIONAL] Enable the background research-cycle scheduler.
# RESEARCH_LAB_SCHEDULER_ENABLED=false
# RESEARCH_LAB_SCHEDULER_POLL_S=3600

# ── Local dev sidecar ─────────────────────────────────────────────────────────
# [OPTIONAL] Set to "true" ONLY for local development (not docker-compose prod).
# Causes the Node Trainer API to spawn the Python Research Lab server as an
# in-process sidecar — useful when you don't want to run a second container.
# See docker-compose.override.yml for the recommended local-dev setup.
# RESEARCH_LAB_AUTOSTART=true
