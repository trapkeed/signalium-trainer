# =============================================================================
# Signalium Trainer — environment variables
# Copy this file to .env and fill in your values.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Trainer API listens on. nginx proxies /api/* to this port.
PORT=3000

# ── Inbound auth (platform → trainer) ────────────────────────────────────────
# JWKS endpoint published by the Signalium platform.
# The trainer uses this to verify signed JWTs on all admin and lifecycle routes.
# The platform calls the trainer automatically using its own signed tokens —
# no API key or shared secret is needed on the trainer side.
SIGNALIUM_JWKS_URL=https://signaliumai.com/sso/jwks

# ── Outbound auth (trainer → Python Research Lab service) ────────────────────
# Static shared secret used by the Node.js trainer API to authenticate its
# internal calls to the Python Research Lab service (localhost:8002).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value in the Python Research Lab service configuration.
RESEARCH_LAB_ADMIN_TOKEN=change_me_strong_random_token

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/signalium_trainer

# ── Internal service URLs ─────────────────────────────────────────────────────
# Python Research Lab API (default: localhost:8002)
RESEARCH_LAB_API_URL=http://localhost:8002

# QDE API (default: localhost:8001)
QDE_API_URL=http://localhost:8001

# ── Outbound calls (trainer → Signalium platform) ─────────────────────────────
# API key for outbound push calls to the platform (telemetry, ticks, heartbeat,
# execution quality, symbol discovery). Leave blank to disable outbound push —
# the trainer starts normally but any route that calls the platform will throw.
# Obtain from: Admin → API Keys on the Signalium platform.
# SIGNALIUM_PLATFORM_API_KEY=

# Base URL override for staging/testing (defaults to https://signaliumai.com/api)
# SIGNALIUM_PLATFORM_BASE_URL=https://staging.signaliumai.com/api

# ── Optional ──────────────────────────────────────────────────────────────────

# Comma-separated trusted CORS origins (defaults to signaliumai.com + localhost)
# PLATFORM_ALLOWED_ORIGINS=https://yourdomain.com

# Log level: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info
