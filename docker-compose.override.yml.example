# =============================================================================
# docker-compose.override.yml — LOCAL DEVELOPMENT overrides
# =============================================================================
# This file is a template.  Copy it without the .example suffix and edit:
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
# docker compose merges it automatically when present.
# docker-compose.override.yml is gitignored — never commit real values.
#
# What it does
# ------------
# Sets RESEARCH_LAB_AUTOSTART=true on the trainer-api service so that the
# Node process spawns the Python Research Lab server as an in-process
# sidecar.  This means you only need to start one container locally instead
# of building and running both trainer-api and research-lab separately.
#
# Do NOT use this override in production — production always runs research-lab
# as a dedicated container (see docker-compose.yml).
# =============================================================================

services:
  trainer-api:
    environment:
      # Spawn the Research Lab FastAPI sidecar inside the Node process.
      # Requires Python + uvicorn in the same environment (works on the host
      # or in a combined dev image; not suitable for the prod Node-only image).
      RESEARCH_LAB_AUTOSTART: "true"
    # In local dev, expose research-lab port via the Node sidecar rather than
    # a separate container, so override the depends_on health-gate.
    depends_on: {}

  # Disable the dedicated research-lab service in local dev; the sidecar
  # inside trainer-api handles it instead.
  research-lab:
    profiles:
      - disabled
