# =============================================================================
# Signalium Trainer — Research Lab API service
# =============================================================================
# Purpose : Runs the Python FastAPI Research Lab server (port 8002).
#           CPU-only — no GPU is needed for admin/research operations.
# Usage   : Built and started automatically by docker-compose.yml.
#           Can also be run standalone:
#
#   docker build -f docker/Dockerfile.research-lab -t signalium-research-lab .
#   docker run -p 8002:8002 \
#     -e RESEARCH_LAB_ADMIN_TOKEN=<secret> \
#     -v $(pwd)/data:/app/data \
#     signalium-research-lab
# =============================================================================

FROM python:3.12-slim

LABEL maintainer="Signalium <engineering@signalium.io>"
LABEL description="Signalium Trainer — Research Lab API (CPU)"

ARG DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# System dependencies
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade --no-cache-dir pip setuptools wheel

# ---------------------------------------------------------------------------
# PyTorch (CPU wheel) — installed first so pip install -e "." finds torch
# already satisfied and does not pull the default CUDA wheel from PyPI.
# ---------------------------------------------------------------------------
RUN pip install --no-cache-dir "torch>=2.3.0" \
        --index-url https://download.pytorch.org/whl/cpu \
        --timeout 120 --retries 3 || \
    pip install --no-cache-dir "torch>=2.3.0" --timeout 120 --retries 3

RUN pip install --no-cache-dir "torchmetrics>=1.4.0"

# ---------------------------------------------------------------------------
# Project dependencies
# ---------------------------------------------------------------------------
WORKDIR /app

COPY pyproject.toml ./

RUN pip install --no-cache-dir -e "." \
        --extra-index-url https://download.pytorch.org/whl/cpu

# ---------------------------------------------------------------------------
# Application source
# ---------------------------------------------------------------------------
COPY . .

# Re-install editable now that the full source tree is present.
RUN pip install --no-cache-dir -e "." \
        --extra-index-url https://download.pytorch.org/whl/cpu

# ---------------------------------------------------------------------------
# Runtime configuration
# ---------------------------------------------------------------------------
VOLUME ["/app/data"]

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV SIGNALIUM_DEVICE=cpu

# Port the Research Lab FastAPI server listens on.
# Must match RESEARCH_LAB_PORT (default 8002) in the Node service.
EXPOSE 8002

# ---------------------------------------------------------------------------
# Health check — hits the /health endpoint (no auth required)
# ---------------------------------------------------------------------------
HEALTHCHECK --interval=15s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -f http://localhost:8002/health || exit 1

# ---------------------------------------------------------------------------
# Startup
# ---------------------------------------------------------------------------
CMD ["uvicorn", \
     "trainer.research_lab.research_lab_server:app", \
     "--host", "0.0.0.0", \
     "--port", "8002", \
     "--workers", "1"]
